generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------ENUMS------------
enum UserRole {
  STUDENT
  ADMIN
}

enum ProjectRole {
  OWNER
  CONTRIBUTOR
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ResourceType {
  DOCUMENT
  PAPER
  LINK
  IMAGE
}

enum MemberStatus {
  PENDING
  ACTIVE
  LEFT
  REMOVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  BREACHED
}

enum ActivityType {
  COMMIT
  UPLOAD
  MESSAGE
  MILESTONE
  OTHER
}

enum PenaltySeverity {
  MINOR
  MAJOR
}

enum TagType {
  SKILL
  INTEREST
}

enum ContentType {
  MESSAGE
  PROJECT_DESCRIPTION
  COMMENT
  BIO
}

enum FlagType {
  SPAM
  TOXIC
  CLEAN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REMOVED
}

enum NotificationType {
  MEMBERSHIP_REQUEST
  MEMBERSHIP_ACCEPTED
  MEMBERSHIP_REJECTED
  MEMBER_REMOVED
  PROJECT_STARTED
  CONTRACT_SIGNED
  CONTRACT_ACTIVATED
  BADGE_AWARDED
  PENALTY_ISSUED
}

// ------------USER AND USER SKILLS------------
model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  fullName           String
  email              String                   @unique
  passwordHash       String
  department         String?
  batch              String?
  githubUrl          String?
  linkedinUrl        String?
  profileImage       String?
  role               UserRole                 @default(STUDENT)
  bio                String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  emailVerified      DateTime?
  lastLoginAt        DateTime?
  institutionId      String?                  @db.Uuid
  skillsUpdatedAt    DateTime?

  accounts           Account[]
  activityLogs       ActivityLog[]
  contractRoles      ContractRole[]
  contractSignatures ContractSignature[]
  credentials        Credential[]
  verificationTokens EmailVerificationToken[]
  receivedMessages   Message[]                @relation("ReceivedMessages")
  sentMessages       Message[]                @relation("SentMessages")
  reviewedFlags      ModerationFlag[]
  penaltyTags        PenaltyTag[]
  ownedProjects      Project[]
  projectAuditLogs   ProjectAuditLog[]
  projectMemberships ProjectMember[]
  resources          ProjectResource[]
  sessions           Session[]
  institution        Institution?             @relation(fields: [institutionId], references: [id])
  badges             UserBadge[]
  embedding          UserEmbedding?
  skills             UserSkill[]
  papers             Paper[]
  notifications      Notification[]

  @@index([deletedAt])
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())

  users User[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------AUTH------------
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// No id field - NextAuth identifies these by the (identifier, token) pair.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Skill {
  id       String      @id @default(uuid()) @db.Uuid
  name     String
  type     TagType
  category String?

  users UserSkill[]

  @@unique([name, type])
}

model UserSkill {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  skillId     String @db.Uuid
  proficiency Int?   // for when skill.type == SKILL; left null for INTEREST

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// Pointer into the external vector DB; does not store the embedding itself
model UserEmbedding {
  userId       String   @id @db.Uuid
  vectorId     String
  modelVersion String
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------PROJECTS AND COLLABORATION------------
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  ownerId     String        @db.Uuid
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  startedAt   DateTime?

  activityLogs  ActivityLog[]
  contract      Contract?
  credentials   Credential[]
  messages      Message[]
  penaltyTags   PenaltyTag[]
  owner         User              @relation(fields: [ownerId], references: [id])
  auditLogs     ProjectAuditLog[]
  members       ProjectMember[]
  badgesAwarded UserBadge[]
  notifications Notification[]

  githubUrl     String?
  boardUrl      String?
  docsUrl       String?

  resources     ProjectResource[]

  @@index([status])
  @@index([deletedAt])
  @@index([ownerId])
}

model ProjectMember {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  userId    String       @db.Uuid
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?
  role      ProjectRole  @default(CONTRIBUTOR)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectAuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  action    AuditAction
  changes   Json?
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

model ProjectResource {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  title       String
  type        ResourceType
  url         String
  addedById   String    @db.Uuid
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy User    @relation(fields: [addedById], references: [id])

  @@index([projectId, createdAt])
}

// ------------DIGITAL AGREEMENT------------
model Contract {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @unique @db.Uuid
  content     Json
  status      ContractStatus @default(DRAFT)
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  finalizedAt DateTime?
  deletedAt   DateTime?

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roles      ContractRole[]
  signatures ContractSignature[]
}

model ContractRole {
  id               String  @id @default(uuid()) @db.Uuid
  contractId       String  @db.Uuid
  userId           String  @db.Uuid
  roleTitle        String
  responsibilities String?
  expectedHours    Int?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([contractId])
  @@index([userId])
}

model ContractSignature {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @db.Uuid
  userId     String   @db.Uuid
  signedAt   DateTime @default(now())
  ipAddress  String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([userId])
}

// ------------ACCOUNTABILITY LOOP------------
model ActivityLog {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  userId       String       @db.Uuid
  activityType ActivityType
  description  String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

model Badge {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  criteria    String?
  iconUrl     String?

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  badgeId   String   @db.Uuid
  projectId String?  @db.Uuid
  awardedAt DateTime @default(now())

  badge   Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, projectId])
  @@index([userId])
  @@index([badgeId])
  @@index([projectId])
}

model PenaltyTag {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  projectId  String          @db.Uuid
  reason     String
  severity   PenaltySeverity @default(MINOR)
  issuedAt   DateTime        @default(now())
  resolvedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model Credential {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  projectId        String?  @db.Uuid
  credentialType   String
  issuedAt         DateTime @default(now())
  verificationHash String   @unique
  pdfUrl           String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

// ------------MESSAGING AND MODERATION------------
model Message {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String?   @db.Uuid
  senderId    String    @db.Uuid
  recipientId String?   @db.Uuid
  content     String
  fileName    String?
  filePath    String?
  fileType    String?
  fileSize    Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User?    @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([senderId])
  @@index([recipientId])
  @@index([projectId, createdAt])
}

model ModerationFlag {
  id              String           @id @default(uuid()) @db.Uuid
  contentType     ContentType
  contentId       String           @db.Uuid
  flagType        FlagType
  confidenceScore Float
  status          ModerationStatus @default(PENDING)
  reviewedById    String?          @db.Uuid
  createdAt       DateTime         @default(now())

  reviewedBy User? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([reviewedById])
}

// ------------PAPER AND RECOMMENDATION------------
model Paper {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  authors   String?
  url       String?
  filePath  String?
  addedById String   @db.Uuid
  createdAt DateTime @default(now())

  addedBy User @relation(fields: [addedById], references: [id])

  @@index([addedById])
}

// ------------NOTIFICATION------------
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  type          NotificationType
  message       String
  projectId     String?          @db.Uuid
  relatedUserId String?          @db.Uuid
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([projectId])
}

model SystemSettings {
  id                   String   @id @default("singleton")
  sessionTimeoutMinutes Int     @default(43200) // 30 days, matches current SESSION_MAX_AGE
  maxUploadSizeMB      Int      @default(20)
  updatedAt            DateTime @updatedAt
  updatedById          String?  @db.Uuid
}